<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Web Của Tôi</title>
    <style>
        /* Cấu hình cơ bản xóa khoảng trắng thừa */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #1e1f22; /* Màu nền tối giống Discord */
            color: #fff;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Khung chứa chia làm 2 cột */
        .container {
            display: flex;
            width: 100%;
            height: 100%;
        }

        /* --- MỤC 1: MENU (Bên trái) --- */
        .menu-section {
            flex: 1; /* Chiếm 1/3 màn hình */
            background-color: #2b2d31;
            padding: 30px;
            display: flex;
            flex-direction: column;
            border-right: 2px solid #1e1f22;
        }

        .menu-section h2 {
            margin-bottom: 20px;
            color: #5865F2; /* Màu xanh thương hiệu Discord */
            font-size: 24px;
        }

        .menu-list {
            list-style: none;
        }

        .menu-list li {
            margin-bottom: 15px;
        }

        .menu-list a {
            color: #dbdee1;
            text-decoration: none;
            font-size: 18px;
            display: block;
            padding: 10px 15px;
            border-radius: 5px;
            transition: background 0.2s, color 0.2s;
        }

        .menu-list a:hover {
            background-color: #35373c;
            color: #fff;
        }

        /* --- MỤC 2: DISCORD (Bên phải) --- */
        .discord-section {
            flex: 2; /* Chiếm 2/3 màn hình (rộng gấp đôi menu) */
            background-color: #313338;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .discord-section h2 {
            margin-bottom: 15px;
            align-self: flex-start;
        }

        /* Khung hiển thị Discord */
        .discord-widget {
            width: 100%;
            height: 85%;
            max-width: 800px;
            border: none;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        /* Tự động chuyển thành hàng dọc nếu xem bằng điện thoại */
        @media (max-width: 768px) {
            .container {
                flex-direction: column;
            }
            body {
                overflow: auto;
            }
            .menu-section {
                flex: none;
                width: 100%;
            }
            .discord-section {
                height: 600px;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        
        <!-- MỤC 1: MENU BÊN TRÁI -->
        <section class="menu-section">
            <h2>DANH MỤC</h2>
            <ul class="menu-list">
                <li><a href="#trang-chu">🏠 Trang Chủ</a></li>
                <li><a href="#tin-tuc">📰 Tin Tức</a></li>
                <li><a href="#nap-the">💳 Nạp Thẻ</a></li>
                <li><a href="#ho-tro">🛠️ Hỗ Trợ</a></li>
            </ul>
        </section>

        <!-- MỤC 2: DISCORD BÊN PHẢI -->
        <section class="discord-section">
            <h2>CỘNG ĐỒNG DISCORD</h2>
            <!-- BẠN SẼ THAY LINK Ở DÒNG SRC DƯỚI ĐÂY THEO BƯỚC 2 -->
            <iframe class="discord-widget" 
                    src= https://discord.gg/NVANujBGn
                    allowtransparency="true" 
                    frameborder="0" 
                    sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts">
            </iframe>
        </section>

    </div>

</body>
</html>
